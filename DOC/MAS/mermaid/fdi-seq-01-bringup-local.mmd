%%{init: {'theme': 'neutral'}}%%
sequenceDiagram
    participant SW as Software
    participant CORE as AOU_CORE
    participant BRG as AOU_FDI_BRINGUP_CTRL
    participant ADP as UCIe Adapter
    participant REM as Remote die
    Note over CORE,ADP: RESET - lp_state_req = NOP, lp_wake_req = 0, O_FDI_LINK_UP = 0, O_INT_FSM_IN_ACTIVE = 0
    ADP->>BRG: pl_state_sts = Reset (0000), pl_inband_pres = 1
    Note over BRG: WAIT_PRESENCE (NOP)
    alt system pulses the top-level port
        SW->>BRG: I_SW_ACTIVATE_START = 1
    else local traffic with AoU DISABLED, or a received ActivateReq
        Note over CORE: AXI transaction pending, ACTIVATE_START = 0
        CORE->>SW: INT_ACTIVATE_START
        CORE->>BRG: I_INT_ACTIVATE_START = 1 (the same signal)
    end
    Note over BRG: WAKE_ASSERT
    BRG->>ADP: lp_wake_req = 1
    ADP->>BRG: pl_wake_ack = 1
    Note over BRG: REQ_ACTIVE
    BRG->>ADP: lp_state_req = Active (0001)
    ADP->>BRG: pl_state_sts = Active (0001)
    ADP->>BRG: pl_rx_active_req = 1
    BRG->>ADP: lp_rx_active_sts = 1
    Note over CORE,ADP: ACTIVE - O_FDI_LINK_UP = 1, O_FDI_FSM_STATE = 0x1
    BRG->>CORE: O_INT_FSM_IN_ACTIVE = 1 (link established)
    SW->>CORE: APB write AOU_INIT.ACTIVATE_START = 1 (allowed earlier too - it does not wake the link)
    CORE->>REM: ActivateReq
    REM->>CORE: ActivateAck
    Note over CORE: ENABLED, ACTIVATE_START self-clears
