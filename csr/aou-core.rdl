    // -------------------------------------------------------------------------
    reg {
        regwidth = 32;
        name = "Write Early Response WDT Control";
        desc = "Threshold of the early-response write-transaction watchdog, shared by all RPs. Each RP's watchdog is enabled by write_early_response_rpN.wdt_en and reports through write_early_response_rpN.wdt_trans_timeout_err.";
        field { sw = rw; desc = "Watchdog threshold in I_CLK cycles. The watchdog counts cycles without an AW or B handshake while writes are outstanding (AW accepted, B from the remote die not yet received) and restarts on either handshake; reaching the threshold sets wdt_trans_timeout_err once per reset. Reset 0xC3500 = 800000 cycles (800 us at 1 GHz)."; } wdt_threshold[31:0] = 0xC3500;
